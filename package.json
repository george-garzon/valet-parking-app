{
  "name": "porter-valet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:integration": "python3 tests/workflow.py",
    "catalog:sync": "node scripts/sync-vehicles.mjs",
    "staff:create-admin": "node --env-file=.env.local --conditions=react-server --import tsx scripts/create-admin.ts",
    "staff:reset-pin": "node --env-file=.env.local --conditions=react-server --import tsx scripts/reset-staff-pin.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "libphonenumber-js": "^1.13.14",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
