# Copy to .env.local for each deployment. Never commit credentials.
# Each deployment serves ONE business. A unique ID isolates its SQLite records.
# 'parkside' preserves the original prototype's storage/valet.sqlite database.
BUSINESS_ID=parkside
BUSINESS_NAME="The Parkside Hotel"
# hotel enables optional room linking in employee and worker check-in.
# business hides room fields for restaurants, venues, and other operators.
BUSINESS_TYPE=hotel
APP_BRAND_NAME="Porter"
BUSINESS_LOGO_URL=
BRAND_PRIMARY_COLOR="#237766"
BUSINESS_TIMEZONE=America/New_York
VALET_PICKUP_LOCATION="the valet podium"

# Set your actual externally reachable HTTPS URL before enabling live texts.
# Leave blank in local preview to use the app's current URL automatically.
# Never use an AVPMi link for this app's tickets.
PUBLIC_APP_URL=

# Optional parent folder; each business ID has its own database beneath it.
# With no override, parkside uses storage/valet.sqlite; others use storage/<ID>/valet.sqlite.
VALET_STORAGE=

# USD amounts in cents. Changes affect new tickets; existing rates are retained.
RATE_TRANSIENT_CENTS=2500
RATE_OVERNIGHT_CENTS=4500
RATE_MONTHLY_CENTS=25000
PHONE_DEFAULT_COUNTRY=US

# preview: save the message for staff to inspect; no network call or real text.
# disabled: do not prepare guest messages.
# twilio: submit opted-in guest messages automatically after a ticket is saved.
SMS_PROVIDER=preview
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set EITHER a Messaging Service SID or a Twilio sender phone number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Optional publicly accessible HTTPS image for MMS, e.g. YOUR business logo.
# Leave blank for text-only SMS. Do not reuse another guest's ticket image.
SMS_MEDIA_URL=

# Supported placeholders: {brand}, {business}, {guest}, {ticket_number},
# {ticket_url}, {pickup_location}. Use \n for line breaks.
SMS_TEMPLATE="{brand} - {business}\n\nWelcome to {business}! Your ticket # is {ticket_number}.\n\nTo request your vehicle:\n{ticket_url}\n\nThank you for visiting {business}. If you are unable to request your vehicle, please proceed to {pickup_location}."
# Example hotel wording:
# BUSINESS_NAME="The Ben"
# SMS_TEMPLATE="{brand} - {business}\n\nWelcome to {business}! Your ticket # is {ticket_number}.\n\nTo request your vehicle:\n{ticket_url}\n\nWe appreciate you staying with us at {business}. If you are unable to request your vehicle, please proceed to {pickup_location}."
# Guest retrieval checkout (Stripe-hosted, USD). Restart after changes.
GUEST_PAYMENTS_ENABLED=false
GUEST_PAYMENT_REQUIRED=false
GUEST_TIPS_ENABLED=true
GUEST_TIP_PRESETS_CENTS=300,500,1000
# Start with sk_test_; never put this key in NEXT_PUBLIC variables.
STRIPE_SECRET_KEY=
# Register /api/payments/webhook for checkout.session.completed
STRIPE_WEBHOOK_SECRET=
